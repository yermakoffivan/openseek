default:
    just --list

# Check Desktop against the checkout's OpenSeek, protocol, and editor modules.
check:
    moon check --target native --target-dir ../_build --deny-warn
    moon check --target js --target-dir ../_build --deny-warn
    moon fmt --check

# Test both production targets in the scoped Desktop workspace.
test:
    moon test --target native --target-dir ../_build
    moon test --target js --target-dir ../_build

# Build both production targets into the repository's shared build directory.
build:
    moon build --target native --target-dir ../_build
    moon build --target js --target-dir ../_build

# Parse the shared build program and type-check every compatibility entry.
build-scripts-check:
    node --check package/build.mjs
    moon check package/internal/cli package/macos package/windows package/linux package/browser package/dev --target native --target-dir ../_build

# Build the current host's debug package through its historical Moon command.
package:
    {{ if os() == "macos" { "moon run package/macos --target native -- --no-open" } else if os() == "linux" { "moon run package/linux --target native" } else { "moon run package/windows --target native" } }}

# Build and launch the unbundled native host with proton_cli dev.
dev:
    moon run package/dev --target native

# Build the Desktop browser application and run Playwright.
test-browser:
    node package/build.mjs browser
    npm --prefix e2e test
